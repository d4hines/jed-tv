/-! Writes JpegTest/Fixtures.lean from the fixture manifest that
tools/lean/yt/Fixtures.lean (jpeg) writes (with ref.py) under assets:

    lean --run gen-lean.lean FIXTURE_DIR JpegTest/Fixtures.lean -/

def main (args : List String) : IO UInt32 := do
  let [dirStr, outPath] := args | IO.eprintln "usage: gen-lean.lean FIXTURE_DIR OUT.lean"; return 2
  let dir : System.FilePath := dirStr
  let p := "../../../../../assets/build/lean-formats/jpeg/"
  let rows := ((← IO.FS.readFile (dir / "manifest.txt")).splitOn "\n").filter (· != "") |>.map
    fun l => (l.splitOn " ").filter (· != "")
  let mut lines := #["/-! Test inputs compiled into the binary (the transcript runs in QEMU with",
    "no filesystem). Generated by ../gen-lean.lean from the fixtures that",
    "tools/Fixtures.lean (jpeg) writes under assets/. -/", "namespace JpegTest.Fixtures"]
  let mut entries := #[]
  let mut i := 0
  for row in rows do
    let [name, w, h, _] := row | IO.eprintln s!"bad manifest line {row}"; return 1
    lines := lines.push s!"def jpg{i} : String := include_str \"{p}{name}.jpg.b64\""
    lines := lines.push s!"def rgb{i} : String := include_str \"{p}{name}.rgb.b64\""
    let scaled ← (dir / s!"{name}.scaled.b64").pathExists
    if scaled then lines := lines.push s!"def scaled{i} : String := include_str \"{p}{name}.scaled.b64\""
    let sc := if scaled then s!"scaled{i}" else "\"\""
    entries := entries.push s!"  (\"{name}\", {w}, {h}, jpg{i}, rgb{i}, {sc})"
    i := i + 1
  lines := lines ++ #["/-- (name, width, height, JPEG, reference RGB, reference 288x162 tile or \"\"), base64. -/",
    "def all : Array (String × Nat × Nat × String × String × String) := #[",
    ",\n".intercalate entries.toList ++ "]", "end JpegTest.Fixtures"]
  IO.FS.writeFile outPath ("\n".intercalate lines.toList ++ "\n")
  return 0
