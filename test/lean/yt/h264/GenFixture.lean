/-! `h264fixture [DIR]`: the H.264 transcript fixture: short stream copies (no
re-encoding) of the YouTube fixture's first samples and of feature clips
(make them first with `h264clips`), written as hex into
DIR/fixture/H264Fixture.lean (default DIR assets/build/lean-h264,
git-ignored), the `H264Fixture` library of this package. -/

def hexDigit (n : Nat) : Char := if n < 10 then Char.ofNat (48 + n) else Char.ofNat (87 + n)

def hex (b : ByteArray) : String := Id.run do
  let mut s := ""
  for x in b.toList do
    s := (s.push (hexDigit (x.toNat / 16))).push (hexDigit (x.toNat % 16))
  return s

/-- (name, source relative to DIR's parent tree, samples). -/
def cuts (root : System.FilePath) (dir : System.FilePath) : List (String × System.FilePath × Nat) := [
  ("yt136", root / "assets/yt-stage0/record-PVGeM40dABA-visionos-20261031T200633Z/fixtures/136.mp4", 16),
  ("weighted", dir / "clips/default.mp4", 24),
  ("temporal", dir / "clips/temporal.mp4", 16),
  ("slices", dir / "clips/slices.mp4", 8),
  ("cqm", dir / "clips/cqm.mp4", 8),
  ("oddsize", dir / "clips/oddsize.mp4", 8)]

def main (args : List String) : IO UInt32 := do
  let root : System.FilePath := "../../../.."
  let dir : System.FilePath := args.headD (root / "assets/build/lean-h264").toString
  IO.FS.createDirAll (dir / "cut")
  IO.FS.createDirAll (dir / "fixture")
  let mut entries : Array String := #[]
  for (name, src, n) in cuts root dir do
    let out := dir / "cut" / s!"{name}.mp4"
    let r ← IO.Process.output { cmd := "ffmpeg", args := #["-hide_banner", "-loglevel", "error", "-y", "-i",
      src.toString, "-map", "0:v:0", "-c", "copy", "-frames:v", toString n,
      "-movflags", "frag_keyframe+empty_moov+default_base_moof", out.toString] }
    if r.exitCode != 0 then IO.eprintln s!"{name}: {r.stderr}"; return 1
    entries := entries.push s!"  (\"{name}\", \"{hex (← IO.FS.readBinFile out)}\")"
  IO.FS.writeFile (dir / "fixture" / "H264Fixture.lean")
    ("/-! Generated by `lake exe h264fixture` (test/h264): fragmented MP4s as hex. -/\n" ++
     "def H264Fixture.clips : Array (String × String) := #[\n" ++ ",\n".intercalate entries.toList ++ "\n]\n")
  IO.println s!"{dir / "fixture" / "H264Fixture.lean"}: {entries.size} clips"
  return 0
