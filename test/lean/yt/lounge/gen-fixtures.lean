import Lean.Data.Json
/-!
Derives LoungeTest/Fixtures.lean from the host prototype's evidence runs:

    lean --run gen-fixtures.lean [ASSETS_DIR]

Reads two transcripts written by research/dial-lounge/screen.py on
2026-11-01 (git-ignored, under assets/research/dial-lounge/runs/):

  20261101T090812Z  "Link with TV code" end to end with fake_remote.py:
                    bind open, then one long poll carrying remoteConnected,
                    setPlaylist, pause, play, seekTo, setVolume, next,
                    getNowPlaying, remoteDisconnected.
  20261101T091316Z  6.5-minute idle soak: noops and a server-ended poll.

Every `raw` record is one read from the HTTP body, so the chunk boundaries
are the real ones. The screen ID and this screen's device ID are replaced by
fixed fakes; lounge tokens never appear in these records. The token-batch
reply is rebuilt from the recorded fields with a fake token.
-/
open Lean

def screenId := "njtagmoio5n5etc8phl65ma0ra"
def fakeScreenId := "testscreenid00000000000000"
def deviceId := "2af95076-607a-4e71-9037-a2431eaa06ef"
def fakeDeviceId := "00000000-0000-4000-8000-000000000001"

def scrub (s : String) : String := (s.replace screenId fakeScreenId).replace deviceId fakeDeviceId

def hex2 (n : Nat) : String :=
  let d (k : Nat) := if k < 10 then Char.ofNat (48 + k) else Char.ofNat (87 + k)
  String.ofList [d (n / 16), d (n % 16)]

/-- A Lean string literal (the source is UTF-8, so only controls are escaped). -/
def leanStr (s : String) : String :=
  "\"" ++ String.join (s.toList.map fun c =>
    if c == '\\' then "\\\\" else if c == '"' then "\\\"" else if c == '\n' then "\\n"
    else if c == '\r' then "\\r" else if c == '\t' then "\\t"
    else if c.toNat < 32 || c.toNat == 127 then "\\x" ++ hex2 c.toNat else c.toString) ++ "\""

def load (dir : System.FilePath) (run : String) : IO (Array Json) := do
  let text ← IO.FS.readFile (dir / "runs" / run / "transcript.jsonl")
  (text.splitOn "\n").filter (· != "") |>.toArray.mapM fun l => IO.ofExcept (Json.parse l)

def str (e : Json) (k : String) : String := (e.getObjValAs? String k).toOption.getD ""
def kind (e : Json) : String := str e "kind"

/-- Raw chunk lists, one per long poll (split at poll-ended). -/
def polls (ev : Array Json) : Array (Array String) := Id.run do
  let mut out := #[]
  let mut cur := #[]
  for e in ev do
    if kind e == "raw" then cur := cur.push (scrub (str e "text"))
    else if kind e == "poll-ended" then out := out.push cur; cur := #[]
  if !cur.isEmpty then out := out.push cur
  return out

def first (ev : Array Json) (k : String) : IO Json := do
  let some e := ev.find? (kind · == k) | throw (IO.userError s!"no {k} record")
  return e

def main (args : List String) : IO UInt32 := do
  let dir : System.FilePath := args.headD "../../../../assets/research/dial-lounge"
  let e2e ← load dir "20261101T090812Z"
  let soak ← load dir "20261101T091316Z"
  let tok ← first e2e "get_lounge_token_batch"
  let field (k : String) : String := s!"\"{k}\":{((tok.getObjVal? k).toOption.getD Json.null).compress}"
  -- the reply in the recorded field order (Json objects would sort them)
  let tokenBody := "{\"screens\":[{" ++ ",".intercalate [s!"\"screenId\":\"{fakeScreenId}\"",
    field "refreshIntervalInMillis", field "remoteRefreshIntervalMs", field "refreshIntervalMs",
    field "loungeTokenLifespanMs", "\"loungeToken\":\"FAKE-LOUNGE-TOKEN-0123456789\"",
    field "remoteRefreshIntervalInMillis", field "expiration"] ++ "}]}"
  let sends := e2e.filter (kind · == "send")
  let defs := #[("screenIdBody", fakeScreenId), ("tokenBatchBody", tokenBody),
    ("pairingCodeBody", str (← first e2e "get_pairing_code") "code"),
    ("bindOpenBody", scrub (str (← first e2e "bind-open") "body")),
    ("sendOkBody", str sends[0]! "body"),
    ("soakBindOpenBody", scrub (str (← first soak "bind-open") "body"))]
  let arrays := #[("e2ePoll", (polls e2e)[0]!), ("soakPoll1", (polls soak)[0]!), ("soakPoll2", (polls soak)[1]!)]
  let mut lines := #["/-! Recorded Lounge traffic (generated by ../gen-fixtures.lean from the host",
    "prototype's runs of 2026-11-01; screen and device IDs replaced by fakes).",
    "Each element of a chunk array is one read from the HTTP body. -/", "namespace LoungeTest.Fixtures"]
  for (k, v) in defs do lines := lines.push s!"def {k} : String := {leanStr v}"
  for (k, chunks) in arrays do
    lines := lines.push s!"def {k} : Array String := #["
    lines := lines.push (",\n".intercalate (chunks.toList.map fun c => "  " ++ leanStr c) ++ "]")
  lines := lines.push "end LoungeTest.Fixtures"
  IO.FS.writeFile "LoungeTest/Fixtures.lean" ("\n".intercalate lines.toList ++ "\n")
  IO.println ("wrote LoungeTest/Fixtures.lean: " ++ ", ".intercalate (arrays.toList.map fun (k, v) => s!"{k} {v.size} chunks"))
  return 0
