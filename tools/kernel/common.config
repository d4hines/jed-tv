# Applied on top of `make tinyconfig`. Every option is here because the
# player or the QEMU virt machine needs it; Stage 3 trims this list further.

# Console and early output
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Boot an initramfs whose only program is the player (PID 1)
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FILE_LOCKING=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# Per-app users and PID1-owned Unix IPC (issue 12)
CONFIG_MULTIUSER=y
CONFIG_UNIX=y
CONFIG_NAMESPACES=y
# CONFIG_UTS_NS is not set
# CONFIG_IPC_NS is not set
# CONFIG_USER_NS is not set
# CONFIG_PID_NS is not set
# CONFIG_NET_NS is not set
# CONFIG_TIME_NS is not set

# Syscalls Rust std and the player use
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# virtio-mmio transport (QEMU virt)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y

# Network: kernel-side DHCP, so no DHCP client in userspace
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# CONFIG_IPV6 is not set

# Display: virtio-gpu, exposed to the player as plain fbdev (/dev/fb0),
# an API surrogate: the TV's mstar_fbdev_mi also needs MI initialization
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_DEVICE=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Sound: virtio-snd as an ALSA card (/dev/snd/pcmC0D0p)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y

# Input: virtio keyboard as evdev (stand-in for the TV's IR receiver)
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y

# Randomness and wall clock
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_PL031=y

# Interrupt controller and timer of QEMU virt
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y

# Apps sandbox themselves with a seccomp-bpf allowlist of the measured
# platform API (research/syscall-census-20261031.md). The TV kernel has
# SECCOMP_FILTER=y too.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Module loading, like the TV kernel (CONFIG_MODULES=y, unsigned). tvinit
# loads modules with finit_module; TEST_LKM ("hello world") exercises it in QEMU.
CONFIG_MODULES=y
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_LKM=m
