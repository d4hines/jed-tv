# 32-bit ARM (faithful profile): mirrors the TV kernel's shape
# (CONFIG_CPU_V7, VMSPLIT_3G, HIGHMEM, no LPAE, no vDSO).
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VIRT=y
CONFIG_AEABI=y
# CONFIG_OABI_COMPAT is not set
CONFIG_VMSPLIT_3G=y
CONFIG_HIGHMEM=y
# CONFIG_ARM_LPAE is not set
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_KERNEL_MODE_NEON=y
CONFIG_ARM_PSCI=y
# The TV has no vDSO, so clock_gettime is a real syscall there; match it.
# CONFIG_VDSO is not set
# The TV's 4.19 kernel always has the 32-bit time syscalls (the option and the
# *_time64 syscalls only appeared in 5.1). musl uses them, e.g. nanosleep for
# sleeps that fit in 32 bits; without them std::thread::sleep fails with ENOSYS.
CONFIG_COMPAT_32BIT_TIME=y
# Scheduler settings copied from the TV's /proc/config.gz.
CONFIG_PREEMPT=y
CONFIG_HZ_250=y
