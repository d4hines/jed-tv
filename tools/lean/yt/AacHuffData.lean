/-!
Writes `Yt/Aac/HuffData.lean`: the AAC Huffman codebooks (ISO/IEC 14496-3
Tables 4.A.1-4.A.12, scalefactor and spectral codes), taken as numbers from
symphonia-codec-aac 0.5.5's `src/aac/codebooks.rs` (the decoder this Lean
code replaces) so that none is retyped; the values are the standard's, in
codeword-index order.

    lake env lean --run tools/AacHuffData.lean PATH/TO/codebooks.rs Yt/Aac/HuffData.lean
-/

/-- The numbers (decimal or 0x hex) in `s`. -/
def numbers (s : String) : Array Nat := Id.run do
  let mut out := #[]
  let mut cur := ""
  for c in (s ++ " ").toList do
    if c.isAlphanum then cur := cur.push c
    else
      if !cur.isEmpty then
        let v :=
          if cur.startsWith "0x" || cur.startsWith "0X" then
            ((cur.toList.drop 2)).foldl (fun acc ch =>
              16 * acc + (if ch.isDigit then ch.toNat - 48 else ch.toLower.toNat - 87)) 0
          else cur.toNat!
        out := out.push v
      cur := ""
  return out

/-- The elements of `const NAME: [u8|u32; N] = [ ... ];` in `src`. -/
def arr (src name : String) : IO (Array Nat) := do
  let parts := src.splitOn s!"const {name}: ["
  let some rest := parts[1]? | throw (IO.userError s!"missing {name}")
  let some body := ((rest.splitOn "= [")[1]?).bind fun b => (b.splitOn "];")[0]?
    | throw (IO.userError s!"malformed {name}")
  return numbers body

def leanArray (xs : Array Nat) (per : Nat) : String :=
  let rows := (List.range ((xs.size + per - 1) / per)).map fun r =>
    "  " ++ ", ".intercalate ((xs.extract (r * per) (r * per + per)).toList.map toString)
  "#[\n" ++ ",\n".intercalate rows ++ "]"

def main (args : List String) : IO UInt32 := do
  let [srcPath, out] := args | IO.eprintln "usage: AacHuffData codebooks.rs OUT.lean"; return 2
  let src ← IO.FS.readFile srcPath
  let mut books : Array (String × Array Nat × Array Nat) := #[]
  for i in [1:12] do
    books := books.push (s!"cb{i}", ← arr src s!"SPECTRUM_CODEBOOK{i}_LENS", ← arr src s!"SPECTRUM_CODEBOOK{i}_CODES")
  books := books.push ("scf", ← arr src "SCF_CODEBOOK_LENS", ← arr src "SCF_CODEBOOK_CODES")
  let mut lines := #[
    "/-! AAC Huffman codebooks (generated by `tools/AacHuffData.lean`; do not edit).", "",
    "ISO/IEC 14496-3 Tables 4.A.1-4.A.12, in codeword-index order: `<book>Len[i]`",
    "and `<book>Code[i]` are the length and bits of codeword `i`. Transcribed from",
    "symphonia-codec-aac 0.5.5 (`src/aac/codebooks.rs`), the decoder this replaces.",
    "Array literals of small naturals compile to static data. -/", "",
    "namespace Yt.Aac.HuffData", ""]
  for (name, lens, codes) in books do
    unless lens.size == codes.size && (lens.zip codes).all (fun (l, c) => 0 < l && l ≤ 19 && c < 2 ^ l) do
      IO.eprintln s!"{name}: bad codebook"; return 1
    lines := lines ++ #[s!"def {name}Len : Array Nat := {leanArray lens 16}", "",
                        s!"def {name}Code : Array Nat := {leanArray codes 8}", ""]
  lines := lines.push "end Yt.Aac.HuffData"
  IO.FS.writeFile out ("\n".intercalate lines.toList ++ "\n")
  return 0
