#!/bin/sh
# C compiler for Rust build scripts (e.g. ring) targeting armv7-unknown-linux-musleabihf: zig cc with
# zig's bundled musl. Drops the --target/-target the cc crate adds (zig wants
# its own triple spelling) and adds ours.
skip=0
for a in "$@"; do
  shift
  if [ $skip = 1 ]; then skip=0; continue; fi
  case $a in
    --target=*|-march=*|-mfpu=*|-mfloat-abi=*) continue ;;
    -target) skip=1; continue ;;
  esac
  set -- "$@" "$a"
done
exec zig cc -target arm-linux-musleabihf -mcpu=cortex_a55 "$@"
