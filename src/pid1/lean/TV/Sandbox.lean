    | 68 => 46 -- same native-width call
    | _ => 0xffffffff

-- Calls 0..54 and 67..68: runtime/files/devices; 55..66: networking. Input socket
-- read/write needs no socket creation. An app with its own sockets (network
-- bit 1) gets all of 55..66; one that only gets sockets from PID 1 (bit 2)
-- loses 55..57 (socket, connect, bind) and keeps the rest, which it needs to
-- receive and use them; one with neither gets none.
private def skipped (app grants : UInt32) : UInt32 :=
  let network := TV.Apps.network app grants
  if network &&& 1 != 0 then 0 else if network &&& 2 != 0 then 3 else 12
private def count (app grants : UInt32) : UInt32 := 69 - skipped app grants

@[export tv_sandbox_length] def length (app grants arch : UInt32) : UInt32 :=
  if TV.Apps.uid app == 0 || arch > 1 then 1
  else 23 + 2 * count app grants

@[export tv_sandbox_instruction]
def instruction (app grants arch i : UInt32) : UInt64 :=
  if TV.Apps.uid app == 0 || arch > 1 then ret 0x80000000
  else
    let n := count app grants
    if i == 0 then load 4
    else if i == 1 then eq (if arch == 0 then 0x40000028 else 0xc00000b7) 1 0
    else if i == 2 then ret 0x80000000
    else if i == 3 then load 0
    else if i == 4 then eq 435 0 1 -- clone3: do not inspect mutable pointer arguments
    else if i == 5 then ret 0x50026 -- ENOSYS permits libc's clone fallback
    else if i == 6 then eq (if arch == 0 then 120 else 220) 0 9
    else if i == 7 then load 16
    else if i == 8 then ins 0x54 0 0 (~~~(0x007d0f00 : UInt32))
    else if i == 9 then eq 0 1 0
    else if i == 10 then (ret 0x50001)
    else if i == 11 then load 16
    else if i == 12 then ins 0x54 0 0 0x10900 -- VM + SIGHAND + THREAD required
    else if i == 13 then eq 0x10900 1 0
    else if i == 14 then (ret 0x50001)
    else if i == 15 then (ret 0x7fff0000)
    else if i == 16 then eq (if arch == 0 then 387 else 281) 0 4
    else if i == 17 then load 16
    else if i == 18 then eq 1023 1 0 -- CLOEXEC, above hard NOFILE=256
    else if i == 19 then (ret 0x50001)
    else if i == 20 then (ret 0x7fff0000)
    else if i == 21 then load 0
    else if i >= 22 + 2*n then (ret 0x50001)
    else if (i - 22) % 2 == 0 then eq (call arch (let index := (i - 22) / 2
        if index >= 55 then index + skipped app grants else index)) 0 1
    else (ret 0x7fff0000)
end TV.Sandbox
