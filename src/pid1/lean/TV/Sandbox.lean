import TV.Apps
set_option compiler.extract_closed false

/- Linux seccomp program generated by Lean, serialized by the C mechanism.
   arch 0 = ARM EABI, 1 = AArch64. All other architectures fail closed.
   A raw instruction is code:16, jt:8, jf:8, k:32 in a UInt64. -/
namespace TV.Sandbox
private def ins (code jt jf k : UInt32) : UInt64 :=
  code.toUInt64 ||| (jt.toUInt64 <<< 16) ||| (jf.toUInt64 <<< 24) ||| (k.toUInt64 <<< 32)
private def load (offset : UInt32) := ins 0x20 0 0 offset
private def eq (value yes no : UInt32) := ins 0x15 yes no value
private def ret (value : UInt32) := ins 6 0 0 value
-- Minimal Rust/musl plumbing plus app I/O. Exec, identity changes, mounts,
-- ptrace, namespace changes and process signaling are deliberately absent.
private def call (arch i : UInt32) : UInt32 :=
  if arch == 0 then
    match i with
    | 0 => 3 -- read
    | 1 => 4 -- write
    | 2 => 146 -- writev
    | 3 => 322 -- openat
    | 4 => 6 -- close
    | 5 => 217 -- getdents64
    | 6 => 91 -- munmap
    | 7 => 125 -- mprotect
    | 8 => 220 -- madvise
    | 9 => 163 -- mremap
    | 10 => 45 -- brk
    | 11 => 240 -- futex
    | 12 => 162 -- nanosleep
    | 13 => 265 -- clock_nanosleep
    | 14 => 263 -- clock_gettime
    | 15 => 175 -- rt_sigprocmask
    | 16 => 173 -- rt_sigreturn
    | 17 => 186 -- sigaltstack
    | 18 => 1 -- exit
    | 19 => 248 -- exit_group
    | 20 => 172 -- prctl
    | 21 => 242 -- sched_getaffinity
    | 22 => 158 -- sched_yield
    | 23 => 384 -- getrandom
    | 24 => 224 -- gettid
    | 25 => 20 -- getpid
    | 26 => 268 -- tgkill
    | 27 => 397 -- statx
    | 28 => 54 -- ioctl
    | 29 => 192 -- mmap
    | 30 => 197 -- fstat
    | 31 => 327 -- newfstatat
    | 32 => 221 -- fcntl
    | 33 => 140 -- lseek
    | 34 => 199 -- getuid
    | 35 => 200 -- getgid
    | 36 => 256 -- set_tid_address
    | 37 => 338 -- set_robust_list
    | 38 => 369 -- prlimit64
    | 39 => 389 -- membarrier
    | 40 => 398 -- rseq
    | 41 => 122 -- uname
    | 42 => 201 -- geteuid
    | 43 => 202 -- getegid
    | 44 => 983045 -- ARM_set_tls
    | 45 => 403 -- clock_gettime64
    | 46 => 407 -- clock_nanosleep_time64
    | 47 => 422 -- futex_time64
    | 48 => 414 -- ppoll_time64
    | 49 => 168 -- poll
    | 50 => 5 -- open
    | 51 => 174 -- rt_sigaction
    | 52 => 119 -- sigreturn (legacy ARM handler)
    | 53 => 145 -- readv (C stdio)
    | 54 => 180 -- pread64
    | 55 => 281 -- socket
    | 56 => 283 -- connect
    | 57 => 282 -- bind
    | 58 => 286 -- getsockname
    | 59 => 287 -- getpeername
    | 60 => 294 -- setsockopt
    | 61 => 295 -- getsockopt
    | 62 => 290 -- sendto
    | 63 => 292 -- recvfrom
    | 64 => 296 -- sendmsg
    | 65 => 297 -- recvmsg
    | 66 => 336 -- ppoll
    | 67 => 93 -- ftruncate
    | 68 => 194 -- ftruncate64
    | _ => 0xffffffff
  else
    match i with
    | 0 => 63 -- read
    | 1 => 64 -- write
    | 2 => 66 -- writev
    | 3 => 56 -- openat
    | 4 => 57 -- close
    | 5 => 61 -- getdents64
    | 6 => 215 -- munmap
    | 7 => 226 -- mprotect
    | 8 => 233 -- madvise
    | 9 => 216 -- mremap
    | 10 => 214 -- brk
    | 11 => 98 -- futex
    | 12 => 101 -- nanosleep
    | 13 => 115 -- clock_nanosleep
    | 14 => 113 -- clock_gettime
    | 15 => 135 -- rt_sigprocmask
    | 16 => 139 -- rt_sigreturn
    | 17 => 132 -- sigaltstack
    | 18 => 93 -- exit
    | 19 => 94 -- exit_group
    | 20 => 167 -- prctl
    | 21 => 123 -- sched_getaffinity
    | 22 => 124 -- sched_yield
    | 23 => 278 -- getrandom
    | 24 => 178 -- gettid
    | 25 => 172 -- getpid
    | 26 => 131 -- tgkill
    | 27 => 291 -- statx
    | 28 => 29 -- ioctl
    | 29 => 222 -- mmap
    | 30 => 80 -- fstat
    | 31 => 79 -- newfstatat
    | 32 => 25 -- fcntl
    | 33 => 62 -- lseek
    | 34 => 174 -- getuid
