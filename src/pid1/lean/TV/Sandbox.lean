    | 36 => 96 -- set_tid_address
    | 37 => 99 -- set_robust_list
    | 38 => 261 -- prlimit64
    | 39 => 283 -- membarrier
    | 40 => 293 -- rseq
    | 41 => 160 -- uname
    | 42 => 175 -- geteuid
    | 43 => 177 -- getegid
    | 44 => 4294967295 -- ARM_set_tls
    | 45 => 4294967295 -- clock_gettime64
    | 46 => 4294967295 -- clock_nanosleep_time64
    | 47 => 4294967295 -- futex_time64
    | 48 => 4294967295 -- ppoll_time64
    | 49 => 4294967295 -- poll
    | 50 => 4294967295 -- open
    | 51 => 134 -- rt_sigaction
    | 52 => 139 -- sigreturn (legacy ARM handler)
    | 53 => 65 -- readv (C stdio)
    | 54 => 67 -- pread64
    | 55 => 198 -- socket
    | 56 => 203 -- connect
