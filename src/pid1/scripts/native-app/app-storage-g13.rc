# upgrade is reserved for signed Lean app banks and the boot journal.
# Import after stock definitions in both native and Android boot selections.
service update_engine /system/bin/sh -c "exit 0"
    override
    class late_start
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on early-init
    wait /dev/block/by-name/upgrade 5
    exec u:r:su:s0 root root -- /system/bin/sh /metadata/dande-tv/app-storage.sh
