# Imported last, after the stock service definitions.
# Installed only when native Wi-Fi has been configured.
import /metadata/dande-tv/wifi/service.rc

on early-init
    # Framework-free G13 uses the explicit connected-subnet route below.
    # Avoid libnetd_client sending su-owned TCP descriptors to enforcing netd;
    # that blocks adb root's accept path (netd -> su fd use is denied).
    export ANDROID_NO_USE_FWMARK_CLIENT 1
    exec u:r:su:s0 root root -- /system/bin/sh /metadata/dande-tv/early.sh

on post-fs-data
    start dande-network

service dande-network /system/bin/sh /metadata/dande-tv/network.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

service zygote /system/bin/sh /metadata/dande-tv/boot.sh
    override
    class main
    user root
    group root readproc reserved_disk
    seclabel u:r:su:s0
    disabled
    oneshot

service bootanim /system/bin/sh -c "exit 0"
    override
    class core animation
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot
