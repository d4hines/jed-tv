import ZrAsm.Neon

/-!
# ZrAsm.Ffmpeg.Common: FFmpeg's `asm.S` and `neon.S` macros in Lean

FFmpeg 9.0.1's 32-bit ARM assembly (libavcodec/arm) is written with GNU
assembler macros from libavutil/arm/asm.S and libavcodec/arm/neon.S; the
modules under `ZrAsm.Ffmpeg` are those files as Lean `Asm` code, and these
are the macros they use, for FFmpeg's configuration for the TV (its
config.h: ARM mode, NEON, ARMv6T2, ELF, no PIC, VFP arguments):

* the file header asm.S emits (`.arch`, `.fpu`, the EABI attributes, the
  non-executable stack note);
* `function` / `endfunc`: `.text`, `.align`, `.global` if exported,
  `.type %function`, the label, the body, `.size`;
* `const` / `endconst`: the same in `.rodata`, without a type;
* `movrel`: an address as a `movw`/`movt` pair (`#:lower16:`/`#:upper16:`);
* neon.S's transposes and `swap4`.

asm.S and neon.S are Copyright (c) 2008 Mans Rullgard <mans@mansr.com>,
part of FFmpeg, under the GNU Lesser General Public License 2.1 or later
(see `lgplNotice`).

`test/ffmpeg/AsmCheck.lean` assembles each generated file and FFmpeg's
original with the same compiler and flags and requires identical sections,
relocations and symbols.
-/

namespace ZrAsm.Ffmpeg

open ZrAsm Asm

/-- The licence paragraph every FFmpeg source file carries. -/
def lgplNotice : String :=
"This file is part of FFmpeg.

FFmpeg is free software; you can redistribute it and/or
modify it under the terms of the GNU Lesser General Public
License as published by the Free Software Foundation; either
version 2.1 of the License, or (at your option) any later version.

FFmpeg is distributed in the hope that it will be useful,
but WITHOUT ANY WARRANTY; without even the implied warranty of
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
Lesser General Public License for more details.

You should have received a copy of the GNU Lesser General Public
License along with FFmpeg; if not, write to the Free Software
Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA"

/-- One FFmpeg assembly file: its name (`h264cmc_neon` for
libavcodec/arm/h264cmc_neon.S), its copyright lines, the Lean module it is
written in, and its contents after the header. -/
structure AsmFile where
  name : String
  copyright : List String
  module : String
  body : Asm Unit

/-- What libavutil/arm/asm.S emits before any code, in this configuration. -/
def header : Asm Unit := do
  emit (.arch "armv7-a")
  emit (.objectArch "armv4")
  emit (.fpu "neon")
  emit (.eabiAttribute 10 0)      -- suppress Tag_FP_arch
  emit (.eabiAttribute 12 0)      -- suppress Tag_Advanced_SIMD_arch
  emit .syntaxUnified
  emit (.eabiAttribute 25 1)      -- Tag_ABI_align_preserved
  emit .noteGnuStack
  emit (.eabiAttribute 28 1)      -- Tag_ABI_VFP_args

def AsmFile.items (f : AsmFile) : List Item := ((header *> f.body).run #[]).2.toList

/-- The `.S` text: the original copyright and licence, where it was
generated from, the items. -/
def AsmFile.text (f : AsmFile) : String :=
  let lines := (f.copyright ++ [""] ++ lgplNotice.splitOn "\n")
  let comment := "\n".intercalate (lines.map fun l => if l = "" then " *" else s!" * {l}")
  s!"/*\n * FFmpeg libavcodec/arm/{f.name}.S, written in the ZrAsm Lean DSL ({f.module}).\n" ++
  s!" * Generated by zr-asm-gen (tools/lean/zr/ZrAsmGen.lean); do not edit.\n *\n{comment}\n */\n" ++
  printItems f.items

/-- asm.S's `function name, export, align` ... `endfunc` (`global` is
`export`). The body is the last argument: `function "f" (global := true) do ...`. -/
def function (name : String) (body : Asm Unit) (global : Bool := false) (align : Nat := 2) : Asm Unit := do
  emit .text
  emit (.balign (2 ^ align))
  if global then emit (.global name)
  emit (.funcType name)
  emit (.label name)
  body
  emit (.size name)

/-- asm.S's `const name, align` ... `endconst` (not relocated: `.rodata`). -/
def const (name : String) (body : Asm Unit) (align : Nat := 2) : Asm Unit := do
  emit (.section ".rodata" "a")
  emit (.balign (2 ^ align))
  emit (.label name)
  body
  emit (.size name)

def bytes (l : List Nat) : Asm Unit := emit (.byte (l.map UInt8.ofNat))
def shorts (l : List Nat) : Asm Unit := emit (.short (l.map UInt16.ofNat))

/-- asm.S's `movrel rd, sym`: without PIC and with ARMv6T2, a
`movw`/`movt` pair of the symbol's (plus `off`) halves. -/
def movrel (rd : Reg) (sym : String) (off : Int := 0) : Asm Unit := do
  ins (.movwSymOff rd sym off)
  ins (.movtSymOff rd sym off)

/-! neon.S -/

def transpose_8x8 (r0 r1 r2 r3 r4 r5 r6 r7 : VReg) : Asm Unit := do
  vtrn 32 r0 r4
  vtrn 32 r1 r5
  vtrn 32 r2 r6
  vtrn 32 r3 r7
  vtrn 16 r0 r2
  vtrn 16 r1 r3
  vtrn 16 r4 r6
  vtrn 16 r5 r7
  vtrn 8 r0 r1
  vtrn 8 r2 r3
  vtrn 8 r4 r5
  vtrn 8 r6 r7

def transpose_4x4 (r0 r1 r2 r3 : VReg) : Asm Unit := do
  vtrn 16 r0 r2
  vtrn 16 r1 r3
  vtrn 8 r0 r1
  vtrn 8 r2 r3

def swap4 (r0 r1 r2 r3 r4 r5 r6 r7 : VReg) : Asm Unit := do
  vswp r0 r4
  vswp r1 r5
  vswp r2 r6
  vswp r3 r7

def transpose16_4x4 (r0 r1 r2 r3 r4 r5 r6 r7 : VReg) : Asm Unit := do
  vtrn 32 r0 r2
  vtrn 32 r1 r3
  vtrn 32 r4 r6
  vtrn 32 r5 r7
  vtrn 16 r0 r1
  vtrn 16 r2 r3
  vtrn 16 r4 r5
  vtrn 16 r6 r7

end ZrAsm.Ffmpeg
