/-!
# Axiom audit and spec surface

Two commands, run on every main theorem so the build log shows the result:

* `#print axioms thm` prints the axioms the proof of `thm` depends on.
  Only `propext`, `Classical.choice` and `Quot.sound` may appear.  Any
  `sorryAx`, `Lean.ofReduceBool` or `*.bv_decide.*` entry would mean a
  proof is unfinished or relies on native computation.
* `#spec_surface thm` prints the definitions from this library that the
  *statement* of `thm` depends on (followed transitively through their
  bodies; the proof is not followed).  These definitions are what a
  reviewer has to read to know what the theorem means.
-/

open Lean Elab Command

/-- Definitions a theorem's statement mentions, followed transitively through
their bodies.  The proof is not followed. -/
partial def specSurface (env : Environment) (thm : Name) : NameSet :=
  let rec go (todo : List Name) (seen : NameSet) : NameSet :=
    match todo with
    | [] => seen
    | c :: rest =>
      if seen.contains c then go rest seen else
      let next := match env.find? c with
        | some (.defnInfo d) => d.type.getUsedConstants.toList ++ d.value.getUsedConstants.toList
        | some ci => ci.type.getUsedConstants.toList
        | none => []
      go (next ++ rest) (seen.insert c)
  match env.find? thm with
  | some ci => go ci.type.getUsedConstants.toList {}
  | none => {}

/-- Is `c` defined in this library (namespace `Gpu`)? -/
def isOwn (c : Name) : Bool :=
  (`Gpu).isPrefixOf c

/-- Names generated by Lean for a structure or inductive type (constructors,
recursors, projections, `casesOn`, ...).  They carry no extra meaning beyond
the type itself, so the listing leaves them out. -/
def isGenerated (env : Environment) (c : Name) : Bool :=
  match env.find? c with
  | some (.ctorInfo _) => true
  | some (.recInfo _) => true
  | _ =>
    env.isProjectionFn c || isAuxRecursor env c || isNoConfusion env c ||
    c.isInternal || Meta.isMatcherCore env c || c.toString.endsWith ".ctorIdx"

/-- `#spec_surface thm`: list this library's definitions that the statement of `thm` depends on. -/
elab "#spec_surface " id:ident : command => do
  let env ← getEnv
  let thm ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo id
  let own := (specSurface env thm).toList.filter fun c =>
    isOwn c && !isGenerated env c && c != thm
  let sorted := own.toArray.qsort (fun a b => a.toString < b.toString)
  logInfo m!"{thm} statement depends on: {sorted.toList}"

